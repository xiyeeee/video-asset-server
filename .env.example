# Local development examples. Replace before sharing an environment.
SPRING_PROFILES_ACTIVE=dev
GATEWAY_PORT=18080
AUTH_PORT=18081
MEDIA_PORT=18082
AI_PORT=18083
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=dev-only-mysql-root
MYSQL_AUTH_PASSWORD=dev-only-auth
MYSQL_MEDIA_USERNAME=video_asset_media
MYSQL_MEDIA_PASSWORD=dev-only-media
MYSQL_AI_USERNAME=video_asset_ai
MYSQL_AI_PASSWORD=dev-only-ai
MYSQL_MIGRATION_PASSWORD=dev-only-migration
MYSQL_NACOS_PASSWORD=dev-only-nacos-db

REDIS_PORT=6379
REDIS_PASSWORD=dev-only-redis

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=video_asset
RABBITMQ_PASSWORD=dev-only-rabbitmq
RABBITMQ_VHOST=video_asset

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=video_asset_dev
MINIO_SECRET_KEY=dev-only-minio-secret
# MINIO_PLAYBACK_ENDPOINT=http://127.0.0.1:9000
# MINIO_REGION=us-east-1
VIDEO_UPLOAD_MAX_FILE_SIZE=100MB
VIDEO_UPLOAD_MAX_REQUEST_SIZE=101MB
VIDEO_UPLOAD_GATEWAY_TIMEOUT_MS=300000
# AI_FFMPEG_PATH=ffmpeg
# AI_MAX_SOURCE_SIZE=100MB

# Python 人物提取服务。Java 与 Python 共享目录时请使用各自可见的绝对路径。
CHARACTER_PYTHON_URL=http://127.0.0.1:19000
EXTRACTION_SUPPORTED_TYPES=SHOT,CHARACTER,AUDIO
CHARACTER_PYTHON_CONNECT_TIMEOUT=2s
CHARACTER_PYTHON_READ_TIMEOUT=5s
# CHARACTER_INPUT_ROOT=.local/character-input
# CHARACTER_OUTPUT_ROOT=.local/character-output
CHARACTER_FRAME_INTERVAL_SECONDS=2
CHARACTER_POLL_INTERVAL=3s
CHARACTER_TASK_TIMEOUT=30m

NACOS_PORT=8848
# Must equal NACOS_PORT + 1000 for the Nacos SDK.
NACOS_GRPC_PORT=9848
NACOS_CONSOLE_PORT=18848
NACOS_USERNAME=nacos
NACOS_PASSWORD=dev-only-nacos-admin
NACOS_CONFIG_GROUP=VIDEO_ASSET
NACOS_AUTH_TOKEN=ZGV2LW9ubHktZXhhbXBsZS1kb250LXVzZS1vdXRzaWRlLWxvY2Fs
NACOS_AUTH_IDENTITY_KEY=video-asset-dev
NACOS_AUTH_IDENTITY_VALUE=dev-only-nacos-identity

JWT_ISSUER=http://localhost:18081
JWT_AUDIENCE=video-asset
JWT_PUBLIC_KEY_LOCATION=file:./.local/jwt-public.pem

# Auth 签发与邮件。部署时仅给 Auth 注入这组配置。
# JWT_PRIVATE_KEY_LOCATION=file:./.local/jwt-private.pem
# AUTH_CODE_HMAC_KEY=用 openssl rand -base64 32 生成
EMAIL_CODE_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_SSL=false
SMTP_STARTTLS=true
